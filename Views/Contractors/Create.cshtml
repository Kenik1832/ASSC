@model ASSC.Models.Contractor

<h2>Создать подрядчика</h2>

<form method="post">

    <div>
        <label>Название</label>
        <input asp-for="Name" />
        <span asp-validation-for="Name"></span>
    </div>

    <div>
        <label>ИНН</label>
        <input asp-for="INN" />
        <span asp-validation-for="INN"></span>
    </div>

    <div>
        <label>Контакты</label>
        <input asp-for="ContactInfo" />
    </div>

    <button type="submit">
        Сохранить
    </button>

</form>