@model IEnumerable<ASSC.Models.Contractor>

<h2>Подрядчики</h2>

<p>
    <a href="/Contractors/Create">Добавить подрядчика</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Название</th>
            <th>ИНН</th>
            <th>Контакты</th>
            <th>Действия</th>
        </tr>
    </thead>

    <tbody>
@foreach (var item in Model)
{
<tr>
    <td>@item.Name</td>
    <td>@item.INN</td>
    <td>@item.ContactInfo</td>

    <td>
        <a href="/Contractors/Edit/@item.Id">Edit</a> |
        <a href="/Contractors/Delete/@item.Id">Delete</a>
    </td>
</tr>
}
    </tbody>
</table>