@model IEnumerable<ASSC.Models.Invoice>

<h2>Счета</h2>

<a href="/Invoices/Create">
Создать счет
</a>

<form method="get">

<input name="Search" placeholder="Поиск по договору" />

<input type="date" name="IssueDateFrom" />
<input type="date" name="IssueDateTo" />

<input name="MinAmount" placeholder="Мин сумма" />
<input name="MaxAmount" placeholder="Макс сумма" />

<select name="Status">
<option value="">Все</option>
<option>Unpaid</option>
<option>Partial</option>
<option>Paid</option>
<option>Overdue</option>
</select>

<button type="submit">Фильтр</button>

</form>

<hr>

<table class="table table-striped table-hover">

<thead class="table-dark">
<tr>
<th>Договор</th>
<th>Сумма</th>
<th>Дата</th>
<th>Срок</th>
<th>Статус</th>
</tr>
</thead>

<tbody>
@foreach(var item in Model)
{
<tr>
<td>@item.Contract?.Number</td>
<td>@item.Amount</td>
<td>@item.IssueDate.ToShortDateString()</td>
<td>@item.DueDate.ToShortDateString()</td>

<td>
<span class="badge 
    @(item.Status=="Paid" ? "bg-success" :
      item.Status=="Overdue" ? "bg-danger" :
      item.Status=="Partial" ? "bg-warning" :
      "bg-secondary")">

    @item.Status
</span>
</td>

</tr>
}
</tbody>

</table>