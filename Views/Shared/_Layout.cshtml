<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - ASSC</title>

    <!-- Bootstrap (оставляем только CDN или локальный — НЕ оба) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ASSC.styles.css" asp-append-version="true" />

    @RenderSection("Styles", required: false)
</head>

<body>

<div class="d-flex">

    <!-- Sidebar -->
    <div class="bg-dark text-white p-3" style="width:250px; min-height:100vh;">

        <h4 class="mb-3">ASSC CRM</h4>
        <hr>

        <ul class="nav flex-column">

            <li class="nav-item">
                <a class="nav-link text-white" href="/Dashboard">Dashboard</a>
            </li>

            <li class="nav-item">
                <a class="nav-link text-white" href="/Suppliers">Поставщики</a>
            </li>

            <li class="nav-item">
                <a class="nav-link text-white" href="/Contractors">Подрядчики</a>
            </li>

            <li class="nav-item">
                <a class="nav-link text-white" href="/Contracts">Договоры</a>
            </li>

            <li class="nav-item">
                <a class="nav-link text-white" href="/Invoices">Счета</a>
            </li>

            <li class="nav-item">
                <a class="nav-link text-white" href="/Payments">Платежи</a>
            </li>

            <li class="nav-item">
                <a class="nav-link text-white" href="/Notifications">Уведомления</a>
            </li>

        </ul>

        <hr>

        <!-- AUTH LINKS -->
        <div>

            <a class="nav-link text-white" href="/Account/Login">Вход</a>

            <a class="nav-link text-white" href="/Account/Register">Регистрация</a>

        </div>

    </div>

    <!-- Content -->
    <div class="flex-grow-1 p-4">

        @RenderBody()

    </div>

</div>

<!-- jQuery (required for validation) -->
<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>

<!-- Bootstrap JS (лучше bundle — ты используешь правильно) -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<!-- Скрипты страниц -->
@RenderSection("Scripts", required: false)

<style>
    body {
        background-color: #f5f6fa;
    }

    .card {
        border-radius: 10px;
    }

    .nav-link {
        padding: 6px 0;
    }

    .nav-link:hover {
        opacity: 0.8;
    }
</style>

</body>
</html>